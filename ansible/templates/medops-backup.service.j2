[Unit]
Description=MedOps PostgreSQL Database Backup
Requires=docker.service
After=docker.service
ConditionPathExists={{ medops_dir }}/compose.yaml

[Service]
Type=oneshot
WorkingDirectory={{ medops_dir }}
Environment=BACKUP_KEEP_COUNT=7
Environment=BACKUP_PRUNE_DRY_RUN=0
ExecStart=/usr/bin/bash {{ medops_dir }}/scripts/backup.sh
TimeoutStartSec=300
UMask=0077
